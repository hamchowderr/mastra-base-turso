# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# Min 32 chars. Generate with: openssl rand -hex 32
APP_SECRET=

# ──────────────────────────────────────────────
# Turso / libSQL — Mastra memory + semantic recall + RAG + observability (@mastra/libsql)
# Local dev: leave BLANK → defaults to a file DB (file:./mastra.db), zero setup.
# Deployed (VPS/Vercel): set a Turso Cloud URL + token — the Tsukuri builder
# provisions one DB per agent via `turso db create`.
# Semantic-recall embeddings use a LOCAL fastembed model (bge-small-en-v1.5,
# 384-dim) — no key/spend. Set EMBEDDING_MODEL to a hosted model
# (e.g. openai/text-embedding-3-small) for serverless/edge where fastembed can't run.
# ──────────────────────────────────────────────
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
# EMBEDDING_MODEL=
# Supabase auth/RLS client vars — optional (only if you add a Supabase auth client;
# NOT the framework store, which is Turso above):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────
# Dolt — versioned business data (mysql2 → dolt sql-server)
# In the compose stack this is the `dolt` service; DOLT_HOST/PORT/USER are set
# there automatically. Set DOLT_PASSWORD (+ optional DOLT_DATABASE) for compose.
# Leave blank to run without Dolt (the Dolt tools error clearly if called).
# ──────────────────────────────────────────────
DOLT_PASSWORD=
DOLT_DATABASE=appdb
# When NOT using compose, also set: DOLT_HOST, DOLT_PORT, DOLT_USER

# ──────────────────────────────────────────────
# Model + LLM provider keys
# MODEL is a Mastra model-router string, "<provider>/<model-id>". It drives the
# example agent, the workflow, and the scorer judges. Blank → the default below.
#   MODEL=anthropic/claude-sonnet-4-6   (needs ANTHROPIC_API_KEY)
#   MODEL=openai/gpt-5.5                (needs OPENAI_API_KEY)
#   MODEL=google/gemini-3.5-flash       (needs GOOGLE_GENERATIVE_AI_API_KEY)
# At least one key is required (none when USE_AIMOCK=true); set the one that
# matches MODEL's provider.
# ──────────────────────────────────────────────
MODEL=anthropic/claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ──────────────────────────────────────────────
# AIMock — deterministic LLM mocking
# Run: npx @copilotkit/aimock --config aimock.json
# ──────────────────────────────────────────────
USE_AIMOCK=false
AIMOCK_URL=http://localhost:4010
# Required when USE_AIMOCK=true — @ai-sdk/openai reads this at module load time,
# before configureAIMock() runs. Set to match AIMOCK_URL + /v1.
# OPENAI_BASE_URL=http://localhost:4010/v1

# ──────────────────────────────────────────────
# E2E (only used during e2e runs)
# ──────────────────────────────────────────────
E2E_BASE_URL=http://localhost:4111

# ──────────────────────────────────────────────
# Mastra
# ──────────────────────────────────────────────
# Recommended for locked-down corporate networks where PostHog is blocked
MASTRA_TELEMETRY_DISABLED=1
# Only set if connecting to hosted Mastra Studio
# MASTRA_CLOUD_ACCESS_TOKEN=
# Hosted Mastra Observe — set BOTH to also ship traces to the platform
# (the MastraPlatformExporter is a no-op unless both are present):
# MASTRA_PLATFORM_ACCESS_TOKEN=
# MASTRA_PROJECT_ID=

# ──────────────────────────────────────────────
# Observability store — defaults to Turso/libSQL (no config needed). Observability
# traces can be high-volume in production; set these to route ONLY the
# observability domain to ClickHouse (Mastra's recommended write-heavy trace
# store) while memory/editor/etc. stay in Turso. Leave unset for Turso.
# ──────────────────────────────────────────────
# CLICKHOUSE_URL=
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=

# ──────────────────────────────────────────────
# Auth — JWT (@mastra/auth), shared HMAC secret. NOT an external provider.
# When set, ALL /api/* routes AND Studio require a Bearer JWT signed with this
# secret. `/health` and `/api/auth/*` stay public (healthchecks + Studio login).
# Leave blank for open local dev. Generate the secret with: openssl rand -hex 32
# ──────────────────────────────────────────────
# MASTRA_JWT_SECRET=
# Mint a client/Studio token (HS256) signed with the secret above:
#   node -e "import('jsonwebtoken').then(j=>console.log(j.default.sign({sub:'client'},process.env.MASTRA_JWT_SECRET)))"
# or use jwt.io's JWT Encoder. Clients send it as: Authorization: Bearer <jwt>
# In Studio: Settings → Headers → Add Header → Authorization = Bearer <jwt>
